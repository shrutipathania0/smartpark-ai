# SmartPark AI Environment Configuration Example
# Copy this file to .env or set secrets in Streamlit Cloud Settings

# Optional: Groq LLM API Key for advanced NLP responses
GROQ_API_KEY=your_groq_api_key_here

# Optional: Custom database path (Defaults to smartpark.db in project root)
DB_PATH=smartpark.db

# Optional: Preferred model weights path
YOLO_MODEL_PATH=yolov8n.pt
